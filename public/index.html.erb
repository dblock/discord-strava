<html lang="en">
 <head>
  <title>Strada: Strava integration with Discord</title>
  <%= partial 'public/partials/_head.html.erb' %>
  <script src="/scripts/register.js"></script>
  <script src="/scripts/status.js"></script>
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <meta name="description" content="Connects Strava in Discord and reposts athlete and club activities into Discord channels, including time, distance, pace, map and weather."/>
  <meta property="og:title" content="Strada: Strava integration with Discord">
  <meta property="og:description" content="Connects Strava in Discord and reposts athlete and club activities into Discord channels, including time, distance, pace, map and weather.">
  <meta name="twitter:title" content="Strada: Strava integration with Discord">
  <meta name="twitter:description" content="Connects Strava in Discord and reposts athlete and club activities into Discord channels, including time, distance, pace, map and weather.">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Strada",
    "url": "<%= DiscordStrava::Service.url %>",
    "applicationCategory": "SocialNetworkingApplication",
    "operatingSystem": "Discord",
    "description": "Connects Strava in Discord and reposts athlete and club activities into Discord channels, including time, distance, pace, map and weather."
  }
  </script>
 </head>
 <body>
  <p class='icon'>
    <a href="/"><img src='img/icon.png' alt="Strada logo"></a>
  </p>
  <p>
    <h1>Strada: Strava integration with Discord</h1>
  </p>
  <p>
    Connects Strava to Discord. Every new activity is reposted into a Discord channel.
  </p>
  <p>
    ⏱ Moving and elapsed time, distance, pace, speed, elevation
    <br>🗺 Includes maps and weather
    <br>🏃 Perfect for your Discord running or cycling club
  </p>
  <p id='messages' />
  <p class='register'>
    <a href="https://discord.com/api/oauth2/authorize?scope=identify+bot&client_id=<%= ENV['DISCORD_CLIENT_ID'] %>&permissions=2147502080&redirect_uri=<%= ENV['URL'] %>&response_type=code"><img alt="Add Strada to Discord" src="img/install.png"></a>
  </p>
  <p>
    <small>
      Free 2 week trial, no credit card required. Subscribe for $19.99/yr.
    </small>
  </p>
  <p>&nbsp;</p>
  <p class='image'>
    <img src='img/notify.png' alt="Example Strava activity notification posted to a Discord channel">
  </p>
  <p class='register'>
    <a href="https://discord.com/api/oauth2/authorize?scope=identify+bot&client_id=<%= ENV['DISCORD_CLIENT_ID'] %>&permissions=2147502080&redirect_uri=<%= ENV['URL'] %>&response_type=code"><img alt="Add Strada to Discord" src="img/install.png"></a>
  </p>
  <p>&nbsp;</p>
  <p>
    <small>
      Money used for servers and to pay for <a href="https://www.strava.com/athletes/dblockdotorg" target="_blank">for my membership and running</a> with the non-profit <a href="https://www.nyrr.org/" target="_blank">nyrr.org</a>.
    </small>
  </p>
  <p>
    <small>
      Looking to add Strava to Slack? Check out <a href="https://slava.playplay.io" target="_blank">Slava</a>.
    </small>
  </p>
  <p class='logo'>
    <a href="https://www.nyrr.org"><img src='img/nyrr.png' alt="New York Road Runners"></a>
  </p>
  <p class='logo'>
    <img src='img/powered.png' alt="Powered by Strava">
  </p>
  <p>
    <small>
      (not officially affiliated with <a target="_blank" href="https://www.strava.com">Strava</a>)
    </small>
  </p>
  <%= partial 'public/partials/_footer.html.erb' %>
 </body>
</html>

