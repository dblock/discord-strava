<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Strada: Update Credit Card</title>
    <%= partial 'public/partials/_head.html.erb' %>
    <meta name="robots" content="noindex, nofollow">
    <%
      team = Team.where(_id: request.params['team_id']).first
      stripe_token = request.params['stripeToken']
      stripe_token_type = request.params['stripeTokenType']
      stripe_email = request.params['stripeEmail']
    %>
  </head>
  <body class="site-page">
    <%= partial 'public/partials/_navigation.html.erb' %>
    <main id="main" class="page-container content-page centered-content">
      <h1>Strada: Update Credit Card Info</h1>
      <p id="messages" role="status" aria-live="polite"></p>
      <div id="update_cc">
        <form action="" method="POST">
        <script
          src="https://checkout.stripe.com/checkout.js" class="stripe-button"
          data-key="<%= ENV['STRIPE_API_PUBLISHABLE_KEY'] %>"
          data-image="<%=h asset_path('/img/icon.png') %>"
          data-name='Strada'
          data-panel-label="Update Credit Card"
          data-label="Update Credit Card"
          data-allow-remember-me=false
          data-locale="auto">
        </script>
        </form>
        <p><img src="<%=h asset_path('/img/stripe.png') %>" width="119" height="26" alt="Powered by Stripe"></p>
        <p>Need a hand? <a href="/help.html#support">Contact support</a>.</p>
      </div>
      <script>
        $(document).ready(function() {
          var data = {
            stripe_token: "<%= stripe_token %>",
            stripe_token_type: "<%= stripe_token_type %>",
            stripe_email: "<%= stripe_email %>",
            team_id: "<%= team ? team.id : nil %>",
            guild_name: '<%= team && team.guild_name.gsub(/[^0-9a-z ]/i, '') %>'
          }

          DiscordStrava.message('Click button to update the credit card for team <b>' + data.guild_name + '.');

          if (data.stripe_token) {
            $.ajax({
              type: 'POST',
              url: '/api/credit_cards',
              data: data,
              success: function(data) {
                DiscordStrava.message('Successfully updated team <b>' + data.guild_name + '</b> credit card.<br><br>Thank you for your support!');
                $('form').remove();
              },
              error: DiscordStrava.error
            });
          } else if (!data.team_id) {
            DiscordStrava.errorMessage("Team not found.")
            $('form').remove();
            $('#update_cc').hide();
          }
        });
      </script>
    </main>
    <%= partial 'public/partials/_footer.html.erb' %>
  </body>
</html>
